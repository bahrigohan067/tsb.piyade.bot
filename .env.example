# ==========================================
# Piyade | Bot Konfigürasyonu
# ==========================================

# Botun Discord Tokeni (Railway Variables kısmına da eklenebilir)
DISCORD_TOKEN=your_bot_token_here
# Alternatif eski değişken adı (TSB_TOKEN de desteklenir)

# Oyun Rolleri (Opsiyonel - tanımlanmazsa games.config.js varsayılanları kullanılır)
# GAME_ROLE_ROBLOX=1571915640976056390
# GAME_ROLE_CS2=1571915951946076323
# GAME_ROLE_ZULA=1571915745884115005
# GAME_ROLE_MINECRAFT=1571915841832886382

# Discord Sunucu ID (Guild ID)
GUILD_ID=1559313292651008040

# Yapay zeka kufur algilama katmani (opsiyonel; yoksa sadece yerel filtre calisir)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

